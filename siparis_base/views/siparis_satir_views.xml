<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form View -->
    <record id="siparis_satir_views_tree" model="ir.ui.view">
        <field name="name">siparis.satir.views.tree</field>
        <field name="model">siparis.siparis.satir</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="siparis_id"/>
                <field name="depo"/>
                <field name="adet" sum="Toplam Adet"/>
                <field name="fiyat"/>
                <field name="toplam_tutar" sum="Alt Toplam"/>
            </tree>
        </field>
    </record>

    <!-- Aksiyon Butonumuz -->
    <record id="action_siparis_satir_views" model="ir.actions.act_window">
        <field name="name">Siparis Satirlari</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">siparis.siparis.satir</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Siparişler Altında "Sipariş Satir" Menüsü -->
    <menuitem id="siparis_satir_menu" name="Sipariş Satırları" parent="siparis_menu" action="action_siparis_satir_views" sequence="11"/>
</odoo>